{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ValenceDraw starten",
      "type": "debugpy",
      "request": "launch",
      "module": "valencedraw",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "ValenceDraw (ohne Debugger)",
      "type": "debugpy",
      "request": "launch",
      "module": "valencedraw",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "console": "integratedTerminal",
      "noDebug": true
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
